<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Platforms>x64</Platforms>
    <!-- Unconditional, not Condition="'$(Platform)'==''": Microsoft.Common.props (imported before this
         PropertyGroup even runs) already defaults Platform to "AnyCPU", so a conditional-on-empty check
         never fires. This forces x64 output (bin/x64/...) regardless of how the build is invoked - bare
         `dotnet build` on this csproj, an IDE's default build task, or the .slnx - instead of depending
         on everyone remembering to build through the solution file. -->
    <Platform>x64</Platform>
    <Version>0.0.2.4</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Rayla Petal</Author>
    <Name>Oathbound</Name>
    <Punchline>Consent-based Owner/Sub control: outfit, title, gesture, and leash.</Punchline>
    <Description>A consent-based collar control plugin. An Owner sends gameplay commands through ordinary
in-game tells; relay-assisted pairing and encrypted catalog synchronization use the Oathbound Cloudflare
service, while all gameplay actions remain local to the Sub's client.</Description>
    <RepoUrl>https://github.com/raylapetal/xiv-collar</RepoUrl>
    <Tags>roleplay;collar;glamourer;penumbra;honorific</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
    <PackageReference Include="ECommons" Version="3.2.1.18" />
    <!-- collar/relay-service: DPAPI protection for the device signing private key (Relay/DeviceIdentityService.cs). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- collar/relay-service: pure-managed ECDSA/ECDH (Relay/RelayCrypto.cs) - System.Security.Cryptography's
         ECDsa/ECDiffieHellman use Windows CNG (NCryptCreatePersistedKey) even under Wine, and Wine's CNG
         shim does not implement EC key generation (NTE_NOT_SUPPORTED, 0x80090029), which crashes the
         plugin on load for any Wine-hosted install. BouncyCastle never touches an OS crypto API. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Built from source against the Penumbra.Api and Luna submodules (matching how Glamourer and
      Penumbra.Api's other consumers build) rather than the published NuGet package - as of
      Penumbra.Api 5.19.0, that package's compiled DLL references an assembly literally named "Luna",
      but the separately-published "Luna" NuGet package's DLL identifies itself as "Luna.Core" (a
      genuine assembly-name mismatch in the published packages, confirmed via disassembling both DLLs'
      assembly references, same finding as PoseKit's) - no reference short of building from source
      resolves it.
    -->
    <ProjectReference Include="..\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Luna\Luna\Luna.csproj" />
    <ProjectReference Include="..\Luna\Luna.Generators\Luna.Generators.csproj" OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
