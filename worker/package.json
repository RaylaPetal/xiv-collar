{
  "name": "oathbound-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "capacity": "node scripts/capacity-model.mjs",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply RELAY_DB --local --env local",
    "db:migrate:staging": "wrangler d1 migrations apply RELAY_DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply RELAY_DB --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "canonicalize": "^2.0.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "workerd@1.20250906.0": true,
    "workerd@1.20260903.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
