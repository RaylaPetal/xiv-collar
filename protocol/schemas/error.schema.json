{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oathbound.example/relay/schemas/error.schema.json",
  "title": "Error",
  "description": "Uniform, non-enumerating error response. Codes are deliberately coarse so a caller cannot distinguish 'wrong capability' from 'does not exist'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schemaVersion", "code"],
  "properties": {
    "type": { "const": "error" },
    "schemaVersion": { "const": 1 },
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "expired",
        "cooldown_active",
        "rate_limited",
        "payload_too_large",
        "service_unavailable"
      ]
    },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/capabilityId",
      "description": "Echoes the caller-supplied request id for correlation only; never a hint about which capability failed validation."
    }
  }
}
